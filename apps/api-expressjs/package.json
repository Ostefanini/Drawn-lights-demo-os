{
    "name": "@drawn-lights-game/api",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch src/index.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "start": "node dist/index.js",
        "openapi": "tsx openapi.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "showDb": "pnpm --filter @drawn-lights-game/prisma studio",
        "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
        "test:cov": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "test:cov:badges": "pnpm run test:cov && npx jest-coverage-badges --output ./badges"
    },
    "dependencies": {
        "@drawn-lights-game/prisma": "workspace:*",
        "@drawn-lights-game/shared": "workspace:*",
        "@idrisay/profanity-check": "^1.6.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.19.0",
        "lodash": "^4.17.21",
        "multer": "^2.0.2",
        "sharp": "^0.34.5",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@jest/globals": "^29.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/lodash": "^4.17.21",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.10.2",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "jest": "^29.4.6",
        "jest-coverage-badges": "^1.1.2",
        "jest-mock-extended": "^2.0.4",
        "prettier": "^3.7.4",
        "prisma": "^7.1.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.6",
        "tsx": "^4.21.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.49.0",
        "zod-openapi": "^5.4.5"
    }
}