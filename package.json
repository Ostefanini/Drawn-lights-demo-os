{
    "name": "drawn-lights-game",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "lint": "pnpm -r --filter './apps/*' lint",
        "test": "pnpm -r --filter './apps/*' test",
        "test:cov:badges": "pnpm -r --filter './apps/*' test:cov:badges",
        "typecheck": "pnpm -r --filter './apps/*' --filter './packages/*' typecheck",
        "fullcheck": "pnpm run lint && pnpm run test && pnpm run typecheck",
        "generate": "dotenv -e .env.dev -- pnpm --filter @drawn-lights-game/prisma generate",
        "migrate": "dotenv -e .env.dev -- pnpm --filter @drawn-lights-game/prisma migrate:dev",
        "migrate:deploy": "dotenv -e .env.dev -- pnpm --filter @drawn-lights-game/prisma migrate:deploy",
        "showDb": "dotenv -e .env.dev -- pnpm --filter @drawn-lights-game/prisma studio",
        "stack:dev": "dotenv -e .env.dev -- docker compose -f docker-compose.dev.yml up -d --wait",
        "stack:dev:down": "dotenv -e .env.dev -- docker compose -f docker-compose.dev.yml down",
        "stack:tests": "dotenv -e .env.test -- docker compose -f docker-compose.tests.yml up -d --build && dotenv -e .env.test -- docker compose -f docker-compose.tests.yml wait migrate-test",
        "test:integration": "pnpm run stack:tests && pnpm --filter api-nestjs test:integration",
        "stack:tests:down": "dotenv -e .env.test -- docker compose -f docker-compose.tests.yml down --remove-orphans",
        "stack:prod:local": "dotenv -e .env.prod.local -- docker compose -f docker-compose.prod.local.yml up -d --wait",
        "stack:prod:local:down": "dotenv -e .env.prod.local -- docker compose -f docker-compose.prod.local.yml down"
    },
    "devDependencies": {
        "dotenv-cli": "^8.0.0",
        "typescript": "^5.9.3"
    },
    "pnpm": {
        "overrides": {
            "@types/express": "^4.17.21",
            "@types/express-serve-static-core": "^4.19.8",
            "dotenv": "^16.6.1"
        }
    },
    "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}